<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PlatformTarget>x64</PlatformTarget>
        <OutputPath>bin\Linux\</OutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <Import Project="..\SharedProject\SharedProject.projitems" Label="Shared" />
    <Import Project="../Build.props" />

    <ItemGroup>
    <Reference Include="0Harmony">
        <HintPath>$(RefsPath)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Barotrauma">
        <HintPath>$(RefsPath)\Linux\Barotrauma.dll</HintPath>
    </Reference>
    <Reference Include="BarotraumaCore">
        <HintPath>$(RefsPath)\Linux\BarotraumaCore.dll</HintPath>
    </Reference>
    <Reference Include="Farseer.NetStandard">
        <HintPath>$(RefsPath)\Farseer.NetStandard.dll</HintPath>
    </Reference>
    <Reference Include="Lidgren.NetStandard">
        <HintPath>$(RefsPath)\Lidgren.NetStandard.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
        <HintPath>$(RefsPath)\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Framework.Linux.NetStandard">
        <HintPath>$(RefsPath)\MonoGame.Framework.Linux.NetStandard.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.Utils">
        <HintPath>$(RefsPath)\MonoMod.Utils.dll</HintPath>
    </Reference>
    <Reference Include="MoonSharp.Interpreter">
        <HintPath>$(RefsPath)\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
    <Reference Include="XNATypes">
        <HintPath>$(RefsPath)\XNATypes.dll</HintPath>
    </Reference>
    </ItemGroup>

    <PropertyGroup>
        <RootNamespace>$(SolutionName.Replace(" ", "_"))</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
        <AssemblyName>$(ProjectName)</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACE;CLIENT;LINUX</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DefineConstants>TRACE;CLIENT;LINUX</DefineConstants>
    </PropertyGroup>

    <Target Name="CopyFiles" AfterTargets="Build">
        <ItemGroup>
            <Assemblies Include="$(TargetDir)$(TargetName).dll" />
            <DepsFiles Include="$(TargetDir)$(TargetName).deps.json" />
        </ItemGroup>
        <Copy SourceFiles="@(Assemblies)" DestinationFiles="$(ModDeployDir)bin\Client\Linux\$(TargetName).dll" />
        <Copy SourceFiles="@(DepsFiles)" DestinationFiles="$(ModDeployDir)bin\Client\Linux\$(TargetName).deps.json" />
    </Target>
    
</Project>
