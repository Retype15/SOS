<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <OutputPath>bin\OSX\</OutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

  <Import Project="..\SharedProject\SharedProject.projitems" Label="Shared" />
  <Import Project="../Build.props" />

    <ItemGroup>
    <Reference Include="0Harmony">
        <HintPath>$(RefsPath)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Barotrauma">
        <HintPath>$(RefsPath)\OSX\Barotrauma.dll</HintPath>
    </Reference>
    <Reference Include="BarotraumaCore">
        <HintPath>$(RefsPath)\OSX\BarotraumaCore.dll</HintPath>
    </Reference>
    <Reference Include="Farseer.NetStandard">
        <HintPath>$(RefsPath)\Farseer.NetStandard.dll</HintPath>
    </Reference>
    <Reference Include="Lidgren.NetStandard">
        <HintPath>$(RefsPath)\Lidgren.NetStandard.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
        <HintPath>$(RefsPath)\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Framework.MacOS.NetStandard">
        <HintPath>$(RefsPath)\MonoGame.Framework.MacOS.NetStandard.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.Utils">
        <HintPath>$(RefsPath)\MonoMod.Utils.dll</HintPath>
    </Reference>
    <Reference Include="MoonSharp.Interpreter">
        <HintPath>$(RefsPath)\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
    <Reference Include="XNATypes">
        <HintPath>$(RefsPath)\XNATypes.dll</HintPath>
    </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SDK\SDK.csproj" />
    </ItemGroup>

  <PropertyGroup>
    <RootNamespace>$(SolutionName.Replace(" ", "_"))</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <AssemblyName>$(ProjectName)</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE;OSX;CLIENT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>TRACE;OSX;CLIENT</DefineConstants>
  </PropertyGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <Assemblies Include="$(TargetDir)$(TargetName).dll" />
      <DepsFiles Include="$(TargetDir)$(TargetName).deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(Assemblies)" DestinationFiles="$(ModDeployDir)bin\Client\OSX\$(TargetName).dll" />
    <Copy SourceFiles="@(DepsFiles)" DestinationFiles="$(ModDeployDir)bin\Client\OSX\$(TargetName).deps.json" />
  </Target>

</Project>
