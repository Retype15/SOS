<Project>

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
        <NuGetAudit>false</NuGetAudit>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
    </PropertyGroup>

    <Import Project="..\Build.props" />

    <PropertyGroup>
        <RootNamespace>$(SolutionName.Replace(" ", "_"))</RootNamespace>
        <AssemblyName>SOS.SDK</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DefineConstants>TRACE;CLIENT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DefineConstants>TRACE;CLIENT</DefineConstants>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(RefsPath)\0Harmony.dll" />
        <Reference Include="Barotrauma" HintPath="$(RefsPath)\$(SdkPlatformFolder)\Barotrauma.dll" />
        <Reference Include="BarotraumaCore" HintPath="$(RefsPath)\$(SdkPlatformFolder)\BarotraumaCore.dll" />
        <Reference Include="Mono.Cecil" HintPath="$(RefsPath)\Mono.Cecil.dll" />
        <Reference Include="$(SdkMonoGameAssembly)" HintPath="$(RefsPath)\$(SdkMonoGameAssembly).dll" />
        <Reference Include="MoonSharp.Interpreter" HintPath="$(RefsPath)\MoonSharp.Interpreter.dll" />
        <Reference Include="XNATypes" HintPath="$(RefsPath)\XNATypes.dll" />
        <Reference Include="MonoMod.Utils" HintPath="$(RefsPath)\MonoMod.Utils.dll" />
        <PackageReference Include="OneOf" Version="3.0.271" ExcludeAssets="runtime" />
    </ItemGroup>

    <Target Name="Deploy" AfterTargets="Build" Condition=" '$(ModDeployDir)' != '' ">
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFiles="$(ModDeployDir)bin\Client\$(SdkPlatformFolder)\$(AssemblyName).dll" />
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).deps.json" DestinationFiles="$(ModDeployDir)bin\Client\$(SdkPlatformFolder)\$(AssemblyName).deps.json" />
        <Copy Condition=" '$(SdkPublishToRefs)' == 'true' " SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFiles="$(RefsPath)\$(AssemblyName).dll" />
    </Target>

</Project>
